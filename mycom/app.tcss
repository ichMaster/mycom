Screen {
    layout: vertical;
    background: #000080;
}

#panel-container {
    layout: horizontal;
    height: 1fr;
}

FileBrowserPanel {
    width: 1fr;
}

StatusBar {
    dock: bottom;
    height: 1;
}

AppHeader {
    dock: top;
    height: 1;
    background: #008080;
    color: #000000;
    text-align: center;
}
